# ============================
# ResumeX Backend - Environment Variables
# ============================
# Copy to .env and fill in your values
# NEVER commit .env to git

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Auth (JWT)
# Use a long random secret in production
JWT_SECRET=change-this-to-a-strong-secret

# Database (PostgreSQL)
# Example: postgres://postgres:password@localhost:5432/resumeX
DATABASE_URL=postgres://postgres:password@localhost:5432/resumeX

# Firebase Admin SDK
# Get from Firebase Console > Project Settings > Service Accounts > Generate New Private Key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# AI Providers
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key

# Redis (for BullMQ queue + caching)
# Use Redis Cloud free tier or Railway Redis
REDIS_URL=redis://localhost:6379

# Stripe (payments)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PREMIUM_PRICE_ID=price_...
STRIPE_ENTERPRISE_PRICE_ID=price_...

# Sentry (error tracking)
SENTRY_DSN=https://xxxxx@sentry.io/xxxxxx
